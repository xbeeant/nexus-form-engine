{
  "type": "object",
  "displayType": "row",
  "labelWidth": 110,
  "properties": {
    "w_input": {
      "type": "string",
      "widget": "input",
      "title": "输入框",
      "default": "1"
    },
    "w_password": {
      "type": "string",
      "widget": "password",
      "title": "密码框",
      "default": "1"
    },
    "w_number": {
      "type": "number",
      "widget": "number",
      "title": "数字输入",
