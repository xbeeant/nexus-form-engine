      "title": "文本域",
      "default": "1"
    },
    "w_select": {
      "type": "string",
      "widget": "select",
      "title": "下拉选择",
      "enum": ["option1", "option2"],
      "enumNames": ["选项1", "选项2"],
      "default": "option2"
    },
    "w_radio": {
      "type": "string",
      "widget": "radio",
