{
  "name": "@nexus/form-engine-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/es/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/es/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./components/*": {
      "types": "./dist/es/components/*.d.ts",
      "import": "./dist/es/components/*.js",
      "require": "./dist/cjs/components/*.js"
    },
    "./hooks/*": {
      "types": "./dist/es/hooks/*.d.ts",
      "import": "./dist/es/hooks/*.js",
      "require": "./dist/cjs/hooks/*.js"
    },
    "./contexts/*": {
      "types": "./dist/es/contexts/*.d.ts",
      "import": "./dist/es/contexts/*.js",
      "require": "./dist/cjs/contexts/*.js"
    },
    "./utils/*": {
      "types": "./dist/es/utils/*.d.ts",
      "import": "./dist/es/utils/*.js",
      "require": "./dist/cjs/utils/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": false },
    "react-dom": { "optional": false }
  },
  "dependencies": {},
  "devDependencies": {}
}
