{
  "name": "@xbeeant/form-engine",
  "version": "0.0.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/es/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "unpkg": "./dist/umd/index.umd.cjs",
  "jsdelivr": "./dist/umd/index.umd.cjs",
  "exports": {
    ".": {
      "types": "./dist/es/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./types/*": {
      "types": "./dist/es/types/*.d.ts",
      "import": "./dist/es/types/*.js",
      "require": "./dist/cjs/types/*.cjs"
    },
    "./utils/*": {
      "types": "./dist/es/utils/*.d.ts",
      "import": "./dist/es/utils/*.js",
      "require": "./dist/cjs/utils/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "!**/*.map"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "npm run build:es && npm run build:cjs && npm run build:umd",
    "prepublishOnly": "npm run build",
    "build:es": "tsc -b && vite build -f es",
    "build:cjs": "vite build -f cjs",
    "build:umd": "vite build -f umd",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
