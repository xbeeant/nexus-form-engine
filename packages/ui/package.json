{
  "name": "@xbeeant/form-engine-ui",
  "version": "0.0.3",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/es/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "unpkg": "./dist/umd/index.umd.cjs",
  "jsdelivr": "./dist/umd/index.umd.cjs",
  "exports": {
    ".": {
      "types": "./dist/es/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "!**/*.map"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "npm run build:es && npm run build:cjs && npm run build:umd",
    "prepublishOnly": "npm run build",
    "build:es": "tsc -b && vite build -f es",
    "build:cjs": "vite build -f cjs",
    "build:umd": "vite build -f umd",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "peerDependencies": {
    "antd": ">=5.0.0",
    "dayjs": ">=1.11.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "antd": {
      "optional": false
    },
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "dayjs": {
      "optional": false
    }
  },
  "dependencies": {
    "@xbeeant/form-engine": "^0.0.3",
    "@xbeeant/form-engine-react": "^0.0.3"
  }
}
